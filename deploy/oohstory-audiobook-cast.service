[Unit]
Description=OOH Story resource-capped audiobook cast scanner
After=network-online.target remote-fs.target mysql.service
Wants=network-online.target
RequiresMountsFor=/srv/oohstory/library

[Service]
Type=simple
User=naslibrary
Group=users
SupplementaryGroups=oohstory
WorkingDirectory=/opt/oohstory-reader
StateDirectory=oohstory-reader
StateDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
Environment=OOHSTORY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_OBJECT_ROOT=/srv/oohstory/library
Environment=OOHSTORY_COMMENT_ROOT=/srv/oohstory/library/comments
Environment=OOHSTORY_MYSQL_HOST=127.0.0.1
Environment=OOHSTORY_MYSQL_PORT=3306
Environment=OOHSTORY_MYSQL_DATABASE=oohstory_library
Environment=OOHSTORY_MYSQL_USER=oohstory_reader
Environment=OOHSTORY_MYSQL_PASSWORD_FILE=/etc/oohstory-reader/mysql-password
Environment=OOHSTORY_MYSQL_POOL_SIZE=4
Environment=OOHSTORY_CAST_PREWARM_ENABLED=1
Environment=OOHSTORY_CAST_PREWARM_WORKER=1
Environment=OOHSTORY_CAST_ENGINE_VERSION=oohstory-cast-v15-colonfield1
Environment=OOHSTORY_GENDER_GUESS_ENABLED=1
Environment=OOHSTORY_GENDER_GUESS_CONFIDENCE_THRESHOLD=0.7
Environment=OOHSTORY_STATE_ROOT=/var/lib/oohstory-reader
ExecStart=/opt/oohstory-reader/.venv/bin/python -m app.audiobook_cast_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Nice=10
CPUQuota=50%
CPUWeight=20
MemoryMax=512M
MemoryHigh=384M
IOWeight=20
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/oohstory-reader
ReadOnlyPaths=/srv/oohstory/library /etc/oohstory-reader
UMask=0077

[Install]
WantedBy=multi-user.target
