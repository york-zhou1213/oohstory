[Unit]
Description=OOH Story reader, account sync, and isolated upload API
After=network-online.target remote-fs.target mysql.service
Wants=network-online.target
RequiresMountsFor=/srv/oohstory/library

[Service]
Type=simple
EnvironmentFile=-/etc/oohstory-reader/oohstory.env
User=oohstory
Group=oohstory
WorkingDirectory=/opt/oohstory-reader
StateDirectory=oohstory-reader
StateDirectoryMode=0700
RuntimeDirectory=oohstory-reader
RuntimeDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
Environment=OOHSTORY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_LIBRARY_ROOT=/srv/oohstory/library
Environment=OOHSTORY_OBJECT_ROOT=/srv/oohstory/library
Environment=OOHSTORY_MYSQL_HOST=127.0.0.1
Environment=OOHSTORY_MYSQL_PORT=3306
Environment=OOHSTORY_MYSQL_DATABASE=oohstory_library
Environment=OOHSTORY_MYSQL_USER=oohstory_reader
Environment=OOHSTORY_MYSQL_PASSWORD_FILE=/etc/oohstory-reader/mysql-password
Environment=OOHSTORY_MYSQL_POOL_SIZE=8
Environment=OOHSTORY_STATE_ROOT=/var/lib/oohstory-reader
Environment=OOHSTORY_USER_UPLOAD_ROOT=/var/lib/oohstory-reader/user-uploads
Environment=OOHSTORY_MAX_UPLOAD_BYTES=67108864
Environment=OOHSTORY_UPLOAD_DAILY_FILES=5
Environment=OOHSTORY_UPLOAD_DAILY_BYTES=268435456
Environment=OOHSTORY_DECONSTRUCTION_ROOT=/srv/oohstory-deconstructions
Environment=OOHSTORY_PUBLIC_ORIGIN=https://reader.example.com
Environment=OOHSTORY_ALLOWED_HOSTS=reader.example.com,localhost,127.0.0.1
ExecStart=/opt/oohstory-reader/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8091 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
ReadOnlyPaths=/opt/oohstory-reader
ReadOnlyPaths=/srv/oohstory/library

[Install]
WantedBy=multi-user.target
