[Unit]
Description=OOH Story bounded low-confidence audiobook cast AI reviewer
After=network-online.target remote-fs.target mysql.service
Wants=network-online.target
RequiresMountsFor=/srv/oohstory/library

[Service]
Type=oneshot
User=root
Group=oohstory
WorkingDirectory=/opt/oohstory-reader
EnvironmentFile=-/etc/oohstory-reader/submission-review.env
Environment=PYTHONUNBUFFERED=1
Environment=OOHSTORY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_OBJECT_ROOT=/srv/oohstory/library
Environment=OOHSTORY_MYSQL_HOST=127.0.0.1
Environment=OOHSTORY_MYSQL_PORT=3306
Environment=OOHSTORY_MYSQL_DATABASE=oohstory_library
Environment=OOHSTORY_MYSQL_USER=oohstory_reader
Environment=OOHSTORY_MYSQL_PASSWORD_FILE=/etc/oohstory-reader/mysql-password
Environment=OOHSTORY_MYSQL_POOL_SIZE=2
Environment=OOHSTORY_STATE_ROOT=/var/lib/oohstory-reader
ExecStart=/opt/oohstory-reader/.venv/bin/python -m app.audiobook_cast_review_worker
TimeoutStartSec=360
Nice=15
CPUQuota=35%
CPUWeight=10
MemoryMax=512M
IOWeight=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077
ReadOnlyPaths=/opt/oohstory-reader /srv/oohstory/library /etc/oohstory-reader
ReadWritePaths=/var/lib/openclaw /var/lib/oohstory-reader
