# Catalog modes:
#   sqlite - legacy production source of truth
#   shadow - SQLite primary plus MySQL shadow writes
#   mysql  - MySQL primary reads and writes
OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql

OOHSTORY_LIBRARY_ROOT=/opt/oohstory-admin/electronic-library

OOHSTORY_LIBRARY_MYSQL_HOST=127.0.0.1
OOHSTORY_LIBRARY_MYSQL_PORT=3306
OOHSTORY_LIBRARY_MYSQL_DATABASE=oohstory_library
OOHSTORY_LIBRARY_MYSQL_USER=oohstory_library_writer
# Pipeline units need their own write-capable account. Do not reuse the
# read-only admin-status credential from /etc/oohstory-admin/mysql-password.
OOHSTORY_LIBRARY_MYSQL_PASSWORD_FILE=/etc/oohstory-admin/library-mysql-password
OOHSTORY_LIBRARY_MYSQL_POOL_SIZE=12

OOHSTORY_LIBRARY_REDIS_HOST=127.0.0.1
OOHSTORY_LIBRARY_REDIS_PORT=6379
OOHSTORY_LIBRARY_REDIS_DB=6
OOHSTORY_LIBRARY_REDIS_PREFIX=oohstory:

# Separate, optional, disposable hot cache. Cache failure always falls back to
# MySQL/NAS; the queue/lease Redis above must keep a no-eviction policy.
OOHSTORY_LIBRARY_CACHE_REDIS_ENABLED=0
OOHSTORY_LIBRARY_CACHE_REDIS_HOST=127.0.0.1
OOHSTORY_LIBRARY_CACHE_REDIS_PORT=6380
OOHSTORY_LIBRARY_CACHE_REDIS_DB=0
OOHSTORY_LIBRARY_CACHE_REDIS_PREFIX=oohstory-cache:
OOHSTORY_LIBRARY_CACHE_REDIS_CONNECT_TIMEOUT=0.2
OOHSTORY_LIBRARY_CACHE_REDIS_SOCKET_TIMEOUT=0.4
OOHSTORY_LIBRARY_CACHE_REDIS_MAX_PAYLOAD_BYTES=262144

OOHSTORY_LIBRARY_OBJECT_ROOT=/srv/oohstory/library
OOHSTORY_LIBRARY_RUNTIME_DIR=/opt/oohstory-admin/electronic-library/全局索引
