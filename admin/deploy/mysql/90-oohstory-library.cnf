[mysqld]
# Sized for this host: 16 GiB RAM, mixed application workload, one HDD.
# Re-tune innodb_io_capacity and the buffer pool after moving MySQL to NVMe.
innodb_buffer_pool_size=6G
innodb_redo_log_capacity=2G
innodb_log_buffer_size=64M
innodb_flush_method=O_DIRECT
innodb_flush_log_at_trx_commit=1
innodb_flush_neighbors=1
innodb_io_capacity=200
innodb_io_capacity_max=800
innodb_read_io_threads=4
innodb_write_io_threads=4
innodb_change_buffering=all
innodb_adaptive_hash_index=ON
innodb_buffer_pool_dump_at_shutdown=ON
innodb_buffer_pool_load_at_startup=ON
innodb_buffer_pool_dump_pct=25
innodb_stats_persistent=ON
innodb_stats_auto_recalc=ON
innodb_stats_persistent_sample_pages=64
innodb_print_all_deadlocks=ON

transaction_isolation=READ-COMMITTED
max_connections=100
thread_cache_size=64
table_open_cache=8000
table_definition_cache=4000
open_files_limit=65535
tmp_table_size=32M
max_heap_table_size=32M
temptable_max_ram=1G
sort_buffer_size=512K
join_buffer_size=512K
read_rnd_buffer_size=512K
skip_name_resolve=ON

slow_query_log=ON
slow_query_log_file=/var/log/mysql/oohstory-library-slow.log
long_query_time=0.5
min_examined_row_limit=100
log_slow_admin_statements=ON
log_slow_extra=ON
log_queries_not_using_indexes=OFF

server_id=1
log_bin=/var/log/mysql/mysql-bin
binlog_format=ROW
binlog_row_image=FULL
sync_binlog=1
binlog_expire_logs_seconds=604800
max_binlog_size=512M
enforce_gtid_consistency=ON
gtid_mode=ON
transaction_write_set_extraction=XXHASH64
binlog_transaction_dependency_tracking=WRITESET

character_set_server=utf8mb4
collation_server=utf8mb4_0900_ai_ci
max_allowed_packet=64M
