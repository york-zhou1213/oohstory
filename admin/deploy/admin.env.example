# Required. Deliberately blank: there are no default credentials.
OOHSTORY_ADMIN_USERNAME=
OOHSTORY_ADMIN_PASSWORD_HASH=
OOHSTORY_ADMIN_SESSION_SECRET=

# Loopback-only routing is /admin/ for UI and /api/admin/ for JSON.
OOH_ADMIN_BASE_PATH=/admin
OOHSTORY_ADMIN_COOKIE_SECURE=0
OOHSTORY_ADMIN_COOKIE_PATH=/
OOHSTORY_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost

# Loopback-only Reader API. The electronic library no longer uses an HTTP
# upstream: OOHStory reads its durable MySQL catalog and shared data path.
OOHSTORY_ADMIN_READER_URL=http://127.0.0.1:8091
OOHSTORY_ADMIN_READER_ALLOWED_HOSTS=
OOHSTORY_ADMIN_UPSTREAM_TIMEOUT=4

# electronic-library must be a symlink to /srv/oohstory/library in the
# deployed project. MySQL is durable; legacy catalog SQLite is never opened.
OOHSTORY_LIBRARY_ROOT=/opt/oohstory-admin/electronic-library/txt80
OOHSTORY_LIBRARY_RUNTIME_DIR=/opt/oohstory-admin/electronic-library/txt80/全局索引
OOHSTORY_LIBRARY_OBJECT_ROOT=/opt/oohstory-admin/electronic-library/txt80
OOHSTORY_LIBRARY_MYSQL_HOST=127.0.0.1
OOHSTORY_LIBRARY_MYSQL_PORT=3306
OOHSTORY_LIBRARY_MYSQL_DATABASE=oohstory_library
# Read-only account created by deploy/mysql/runtime-users.sql.
OOHSTORY_LIBRARY_MYSQL_USER=oohstory_library_reader
OOHSTORY_LIBRARY_MYSQL_PASSWORD_FILE=/etc/oohstory-admin/mysql-password
OOHSTORY_LIBRARY_REDIS_HOST=127.0.0.1
OOHSTORY_LIBRARY_REDIS_PORT=6379
OOHSTORY_LIBRARY_REDIS_DB=6
OOHSTORY_LIBRARY_REDIS_PREFIX=oohstory:

# Optional disposable read cache. This is a separate Redis instance; never
# point it at the operational 6379/DB6 Streams endpoint. Disabled by default.
OOHSTORY_LIBRARY_CACHE_REDIS_ENABLED=0
OOHSTORY_LIBRARY_CACHE_REDIS_HOST=127.0.0.1
OOHSTORY_LIBRARY_CACHE_REDIS_PORT=6380
OOHSTORY_LIBRARY_CACHE_REDIS_DB=0
OOHSTORY_LIBRARY_CACHE_REDIS_PREFIX=oohstory-cache:
OOHSTORY_LIBRARY_CACHE_REDIS_CONNECT_TIMEOUT=0.2
OOHSTORY_LIBRARY_CACHE_REDIS_SOCKET_TIMEOUT=0.4
OOHSTORY_LIBRARY_CACHE_REDIS_MAX_PAYLOAD_BYTES=262144

# Optional bounded policy tuning.
OOHSTORY_ADMIN_SESSION_TTL=28800
OOHSTORY_ADMIN_LOGIN_ATTEMPTS=5
OOHSTORY_ADMIN_LOGIN_WINDOW=900

# Root-owned exact-ID publisher used by the local-only script editor.
OOHSTORY_ADMIN_SCRIPT_STORE_HELPER_PATH=/usr/local/libexec/oohstory-admin-script-store
OOHSTORY_ADMIN_LIBRARY_ACTION_HELPER_PATH=/usr/local/libexec/oohstory-admin-library-action
OOHSTORY_ADMIN_LIBRARY_UPLOAD_DIR=/var/lib/oohstory-admin/cover-uploads
OOHSTORY_ADMIN_MANAGED_SCRIPT_ROOT=/opt/oohstory-admin
