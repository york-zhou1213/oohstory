[Unit]
Description=Refresh the local txt80 electronic-library catalog
After=mysql.service redis-server.service network-online.target
Requires=mysql.service redis-server.service

[Service]
Type=oneshot
EnvironmentFile=/etc/oohstory-admin/library.env
Environment=OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql
WorkingDirectory=/opt/oohstory-admin
ExecStart=/opt/oohstory-admin/.venv/bin/python /opt/oohstory-admin/scripts/electronic-library/scheduled_library_sync.py --library local --refresh-catalog
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=append:/opt/oohstory-admin/electronic-library/txt80/logs/catalog-scan.log
StandardError=append:/opt/oohstory-admin/electronic-library/txt80/logs/catalog-scan.log
