[Unit]
Description=Replace watermarked local covers from exact authorized-source matches
After=mysql.service redis-server.service network-online.target
Requires=mysql.service redis-server.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/oohstory-admin/library.env
Environment=OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_LIBRARY_MYSQL_POOL_SIZE=8
Environment=OOHSTORY_LIBRARY_BROWSER_SERVICE=oohstory-shubaow-browser.service
Environment=OOHSTORY_LIBRARY_SHUBAOW_CDP_URL=http://127.0.0.1:9223
Environment=OOHSTORY_LIBRARY_MYSQL_READ_TIMEOUT=180
Environment=OOHSTORY_LIBRARY_MYSQL_WRITE_TIMEOUT=180
WorkingDirectory=/opt/oohstory-admin
ExecStart=/opt/oohstory-admin/.venv/bin/python scripts/electronic-library/local_source_upgrade_worker.py --batch-size 6
Restart=always
RestartSec=30
TimeoutStopSec=45min
Nice=15
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
