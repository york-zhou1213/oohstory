[Unit]
Description=Full-rate OOHStory electronic-library body synchronization for %i
After=mysql.service redis-server.service network-online.target
Requires=mysql.service redis-server.service

[Service]
Type=simple
EnvironmentFile=/etc/oohstory-admin/library.env
Environment=OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_LIBRARY_MYSQL_READ_TIMEOUT=120
Environment=OOHSTORY_LIBRARY_MYSQL_WRITE_TIMEOUT=120
Environment=OOHSTORY_LIBRARY_IXDZS_MAX_DOWNLOAD_SECONDS=300
WorkingDirectory=/opt/oohstory-admin
ExecStart=/opt/oohstory-admin/.venv/bin/python /opt/oohstory-admin/scripts/electronic-library/site_full_sync.py --site %i
Restart=on-failure
RestartSec=15s
TimeoutStopSec=90s
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
CPUQuota=800%
MemoryHigh=10G
MemoryMax=12G
TasksMax=512
OOMPolicy=stop
StandardOutput=append:/opt/oohstory-admin/electronic-library/txt80/logs/site-full-sync-%i.log
StandardError=append:/opt/oohstory-admin/electronic-library/txt80/logs/site-full-sync-%i.log

[Install]
WantedBy=multi-user.target
