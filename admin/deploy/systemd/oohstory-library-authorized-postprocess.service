[Unit]
Description=Batch metadata and index refresh for authorized downloads
After=mysql.service redis-server.service oohstory-library-authorized-download.service
Requires=mysql.service redis-server.service

[Service]
Type=oneshot
EnvironmentFile=/etc/oohstory-admin/library.env
Environment=OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql
Environment=OOHSTORY_LIBRARY_MYSQL_READ_TIMEOUT=120
Environment=OOHSTORY_LIBRARY_MYSQL_WRITE_TIMEOUT=120
WorkingDirectory=/opt/oohstory-admin
ExecStart=/opt/oohstory-admin/.venv/bin/python /opt/oohstory-admin/scripts/electronic-library/authorized_site_postprocess_worker.py --limit 200 --cover-concurrency 4
Nice=15
IOSchedulingClass=idle
CPUQuota=300%
MemoryHigh=512M
MemoryMax=768M
TasksMax=128
OOMPolicy=stop
TimeoutStartSec=6h
StandardOutput=append:/opt/oohstory-admin/electronic-library/logs/authorized-postprocess.log
StandardError=append:/opt/oohstory-admin/electronic-library/logs/authorized-postprocess.log
