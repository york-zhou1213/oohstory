[Unit]
Description=OOHStory independent library deconstruction worker %i
After=network.target

[Service]
Type=exec
User=root
WorkingDirectory=/opt/oohstory-admin
Environment=PYTHONUNBUFFERED=1
Environment=LIBRARY_TASK_USE_SYSTEMD=1
EnvironmentFile=-/etc/oohstory-admin/library.env
ExecStart=/opt/oohstory-admin/.venv/bin/python /opt/oohstory-admin/src/oohstory_library/services/library_task_worker.py --task-file /srv/oohstory/library/txt80/全局拆书库/.tasks/%i.json
Restart=no
TimeoutStopSec=30
CPUQuota=200%
MemoryHigh=1280M
MemoryMax=1536M
TasksMax=128
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
