[Unit]
Description=Legacy txt80 TXT downloader with targeted plot-free post-processing
After=mysql.service redis-server.service network-online.target
Requires=mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/oohstory-admin/library.env
Environment=OOHSTORY_LIBRARY_CATALOG_BACKEND=mysql
WorkingDirectory=/opt/oohstory-admin
ExecStart=/opt/oohstory-admin/.venv/bin/python /opt/oohstory-admin/scripts/electronic-library/txt80_crawler.py --skip-discovery --workers 2 --delay 0.5 --timeout 60 --max-attempts 8 --min-free-gb 15
Restart=on-failure
RestartSec=20
CPUQuota=200%
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
IOWeight=20
IOReadBandwidthMax=/dev/mapper/ubuntu--vg-ubuntu--lv 32M
IOWriteBandwidthMax=/dev/mapper/ubuntu--vg-ubuntu--lv 16M
OOMPolicy=stop
StandardOutput=append:/opt/oohstory-admin/electronic-library/txt80/logs/download.log
StandardError=append:/opt/oohstory-admin/electronic-library/txt80/logs/download.log

[Install]
WantedBy=multi-user.target
