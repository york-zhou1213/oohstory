def configure_root_runtime_environment() -> None:
    """Use the root-owned AI CLI/config home, independent of sudo's caller."""

    os.environ["HOME"] = "/root"
    os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def emit(ok: bool, message: str, data: dict[str, Any] | None = None, code: int = 0) -> None:
    print(
        json.dumps(
            {"ok": ok, "message": str(message)[:500], "data": data or {}},
            ensure_ascii=False,
            separators=(",", ":"),
        )
    )
    raise SystemExit(code)


def load_environment() -> None:
    if not ENV_FILE.is_file() or ENV_FILE.is_symlink():
        raise RuntimeError("电子书库写入环境尚未配置")
    if ENV_FILE.stat().st_size > 64 * 1024:
        raise RuntimeError("电子书库写入环境文件异常")
    for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "=" not in stripped:
            raise RuntimeError("电子书库写入环境格式无效")
        name, raw = stripped.split("=", 1)
        name = name.strip()
        if not SAFE_ENV_RE.fullmatch(name):
            continue
        parts = shlex.split(raw.strip(), posix=True)
        value = parts[0] if len(parts) == 1 else raw.strip()
        os.environ[name] = value
    os.environ["LIBRARY_TASK_USE_SYSTEMD"] = "1"
    os.environ.pop("OOHSTORY_LIBRARY_LEGACY_UNIT_NAMES", None)


def ensure_roots() -> None:
    PROJECT_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    (PROJECT_ROOT / ".webnovel").mkdir(exist_ok=True, mode=0o700)
    JOB_ROOT.mkdir(parents=True, exist_ok=True, mode=0o750)
    os.chmod(PROJECT_ROOT, 0o700)
    os.chmod(PROJECT_ROOT / ".webnovel", 0o700)
    os.chmod(JOB_ROOT, 0o750)


def read_request() -> dict[str, Any]:
    raw = sys.stdin.buffer.read(64 * 1024 + 1)
    if len(raw) > 64 * 1024:
        raise ValueError("请求超过安全上限")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("请求不是有效 JSON") from exc
    if not isinstance(payload, dict):
        raise ValueError("请求必须是 JSON 对象")
    return payload


def ids(payload: dict[str, Any], *, maximum: int) -> list[int]:
    values = payload.get("catalog_ids")
    if not isinstance(values, list):
        raise ValueError("catalog_ids 必须是数组")
    normalized = sorted({int(value) for value in values if int(value) > 0})
    if not normalized:
        raise ValueError("请至少选择一本作品")
    if len(normalized) > maximum:
        raise ValueError(f"单次最多处理 {maximum} 本作品")
    return normalized


def safe_text(payload: dict[str, Any], name: str, maximum: int) -> str:
    value = str(payload.get(name) or "").strip()
    if not value or len(value) > maximum or "\x00" in value:
        raise ValueError(f"{name} 无效")
    return value


def optional_text(payload: dict[str, Any], name: str, maximum: int) -> str:
    value = str(payload.get(name) or "").strip()
    if len(value) > maximum or "\x00" in value:
        raise ValueError(f"{name} 无效")
    return value


def strict_bool(payload: dict[str, Any], name: str) -> bool:
    value = payload.get(name)
    if not isinstance(value, bool):
        raise ValueError(f"{name} 必须是布尔值")
    return value


def optional_positive_int(payload: dict[str, Any], name: str) -> int | None:
    value = payload.get(name)
    if value is None or value == "":
        return None
    try:
        normalized = int(value)
    except (TypeError, ValueError) as exc:
        raise ValueError(f"{name} 必须是正整数") from exc
    if normalized <= 0 or normalized > 1_000_000:
        raise ValueError(f"{name} 必须是正整数")
    return normalized


def account_connection() -> sqlite3.Connection:
    if not ACCOUNTS_DATABASE.is_file() or ACCOUNTS_DATABASE.is_symlink():
        raise RuntimeError("注册用户数据库不可用")
    connection = sqlite3.connect(ACCOUNTS_DATABASE, timeout=5.0)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys=ON")
    connection.execute("PRAGMA busy_timeout=5000")
    required = {"users", "user_sessions", "registration_invites", "managed_categories"}
    present = {
        str(row[0])
        for row in connection.execute(
            "SELECT name FROM sqlite_master WHERE type='table'"
        )
    }
    if not required.issubset(present):
        connection.close()
        raise RuntimeError("注册用户数据库结构不完整")
    return connection


def normalize_label(value: object, *, maximum: int, field: str) -> str:
    text = " ".join(unicodedata.normalize("NFKC", str(value or "")).split())
    if not text or len(text) > maximum or "\x00" in text:
        raise ValueError(f"{field} 无效")
    return text


def operations_overview(payload: dict[str, Any]) -> dict[str, Any]:
    query = optional_text(payload, "query", 100)
    status = optional_text(payload, "status", 16)
    if status not in {"", "active", "disabled"}:
        raise ValueError("注册用户状态筛选无效")
    conditions: list[str] = []
    params: list[Any] = []
    if query:
        escaped = query.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
        conditions.append("(u.email LIKE ? ESCAPE '\\' OR u.display_name LIKE ? ESCAPE '\\')")
        params.extend((f"%{escaped}%", f"%{escaped}%"))
    if status:
        conditions.append("u.status=?")
        params.append(status)
    where = " WHERE " + " AND ".join(conditions) if conditions else ""
    current = now()
    with account_connection() as connection:
        users = [
            dict(row)
            for row in connection.execute(
                "SELECT u.id,u.email,u.display_name,u.status,u.email_verified_at,"
                "u.created_at,u.updated_at,u.last_login_at,COUNT(DISTINCT s.id) active_sessions "
                "FROM users u LEFT JOIN user_sessions s ON s.user_id=u.id "
                "AND s.revoked_at IS NULL AND s.expires_at>?"
                f"{where} GROUP BY u.id ORDER BY u.created_at DESC,u.id DESC LIMIT 100",
                (current, *params),
            )
        ]
        invites = [
            dict(row) | {"disabled": bool(row["disabled_at"])}
            for row in connection.execute(
                "SELECT id,label,max_uses,used_count,created_at,expires_at,disabled_at,last_used_at "
                "FROM registration_invites ORDER BY created_at DESC LIMIT 100"
            )
        ]
        categories = [
            dict(row) | {"enabled": bool(row["enabled"]), "is_custom": bool(row["is_custom"])}
            for row in connection.execute(
                "SELECT id,source_name,display_name,description,enabled,sort_order,is_custom,"
                "created_at,updated_at FROM managed_categories ORDER BY sort_order,display_name,id"
            )
        ]
        counts = dict(
            connection.execute(
                "SELECT COUNT(*) users,SUM(status='active') active_users FROM users"
            ).fetchone()
        )
    uploads: list[dict[str, Any]] = []
    if JOB_ROOT.is_dir():
        for path in sorted(JOB_ROOT.glob("*.json"), key=lambda item: item.stat().st_mtime, reverse=True)[:100]:
            try:
                job = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if job.get("kind") == "admin_novel":
                uploads.append(sanitized_job(job) | {"title": str((job.get("request") or {}).get("title") or "")[:120]})
    return {
        "summary": {"users": int(counts.get("users") or 0), "active_users": int(counts.get("active_users") or 0)},
        "users": users,
        "invites": invites,
        "categories": categories,
        "uploads": uploads,
    }


def book_publication_overview(payload: dict[str, Any]) -> dict[str, Any]:
    unexpected = set(payload) - {"action", "query", "publication"}
    if unexpected:
        raise ValueError("书籍上下架筛选包含未允许字段")
    query = optional_text(payload, "query", 100)
    publication = optional_text(payload, "publication", 16)
    if publication not in {"", "published", "unpublished"}:
        raise ValueError("书籍上架状态筛选无效")
    service = service_instance()
    if service.mysql_catalog is None:
        raise RuntimeError("MySQL 正式书库不可用")
    return service.mysql_catalog.operations_publication_books(
        query=query,
        publication=publication,
        limit=100,
    )


def update_book_publication(payload: dict[str, Any]) -> dict[str, Any]:
    unexpected = set(payload) - {"action", "catalog_id", "published", "reason"}
    if unexpected:
        raise ValueError("书籍上下架请求包含未允许字段")
    catalog_id = payload.get("catalog_id")
    if type(catalog_id) is not int or catalog_id <= 0:
        raise ValueError("书籍目录标识无效")
    published = strict_bool(payload, "published")
    reason = normalize_label(payload.get("reason"), maximum=240, field="操作原因")
    service = service_instance()
    if service.mysql_catalog is None:
        raise RuntimeError("MySQL 正式书库不可用")
    return service.mysql_catalog.set_book_publication(
        catalog_id,
        published=published,
        reason=reason,
    )


def create_registration_invite(payload: dict[str, Any]) -> dict[str, Any]:
    label = optional_text(payload, "label", 80)
    max_uses = int(payload.get("max_uses") or 1)
    expires_days = int(payload.get("expires_in_days") or 30)
    if not 1 <= max_uses <= 100_000 or not 1 <= expires_days <= 365:
        raise ValueError("邀请码使用次数或有效期无效")
    invite_id = str(uuid.uuid4())
    code = f"OOH-{secrets.token_urlsafe(24)}"
    created = datetime.now(timezone.utc)
    expires_at = (created + timedelta(days=expires_days)).isoformat(timespec="seconds")
    with account_connection() as connection:
        connection.execute(
            "INSERT INTO registration_invites(id,code_hash,label,max_uses,created_at,expires_at) "
            "VALUES(?,?,?,?,?,?)",
            (invite_id, hashlib.sha256(code.encode("utf-8")).digest(), label, max_uses, created.isoformat(timespec="seconds"), expires_at),
        )
    return {"code": code, "item": {"id": invite_id, "label": label, "max_uses": max_uses, "used_count": 0, "expires_at": expires_at}}


def revoke_registration_invite(payload: dict[str, Any]) -> dict[str, Any]:
    invite_id = safe_text(payload, "invite_id", 64)
    with account_connection() as connection:
        result = connection.execute(
            "UPDATE registration_invites SET disabled_at=COALESCE(disabled_at,?) WHERE id=?",
            (now(), invite_id),
        )
    if result.rowcount != 1:
        raise KeyError("邀请码不存在")
    return {"invite_id": invite_id, "disabled": True}


def update_registered_user(payload: dict[str, Any]) -> dict[str, Any]:
    unexpected = set(payload) - {"action", "user_id", "status"}
    if unexpected:
        raise ValueError("注册用户更新包含未允许字段；禁止角色授权")
    user_id = safe_text(payload, "user_id", 64)
    status = safe_text(payload, "status", 16)
    if status not in {"active", "disabled"}:
        raise ValueError("注册用户状态无效")
    stamp = now()
    with account_connection() as connection:
        connection.execute("BEGIN IMMEDIATE")
        target = connection.execute(
            "SELECT id,email,display_name,status FROM users WHERE id=?", (user_id,)
        ).fetchone()
        if not target:
            connection.rollback()
            raise KeyError("注册用户不存在")
        connection.execute(
            "UPDATE users SET status=?,updated_at=? WHERE id=?", (status, stamp, user_id)
        )
        revoked = 0
        if status == "disabled":
            result = connection.execute(
                "UPDATE user_sessions SET revoked_at=COALESCE(revoked_at,?) "
                "WHERE user_id=? AND revoked_at IS NULL",
                (stamp, user_id),
            )
            revoked = max(int(result.rowcount), 0)
        connection.commit()
    return dict(target) | {"status": status, "revoked_sessions": revoked}


def revoke_registered_user_sessions(payload: dict[str, Any]) -> dict[str, Any]:
    unexpected = set(payload) - {"action", "user_id"}
    if unexpected:
        raise ValueError("会话撤销请求包含未允许字段")
    user_id = safe_text(payload, "user_id", 64)
    with account_connection() as connection:
        if not connection.execute("SELECT 1 FROM users WHERE id=?", (user_id,)).fetchone():
            raise KeyError("注册用户不存在")
        result = connection.execute(
            "UPDATE user_sessions SET revoked_at=COALESCE(revoked_at,?) "
            "WHERE user_id=? AND revoked_at IS NULL",
            (now(), user_id),
        )
    return {"user_id": user_id, "revoked_sessions": max(int(result.rowcount), 0)}


def mutate_managed_category(action: str, payload: dict[str, Any]) -> dict[str, Any]:
    stamp = now()
    if action == "category_create":
        name = normalize_label(payload.get("name"), maximum=40, field="分类名称")
        description = optional_text(payload, "description", 240)
        sort_order = min(max(int(payload.get("sort_order") or 100), 0), 10_000)
        category_id = str(uuid.uuid4())
        try:
            with account_connection() as connection:
                connection.execute(
                    "INSERT INTO managed_categories"
                    "(id,source_name,display_name,description,sort_order,is_custom,created_at,updated_at) "
                    "VALUES(?,?,?,?,?,1,?,?)",
                    (category_id, name, name, description, sort_order, stamp, stamp),
                )
        except sqlite3.IntegrityError as exc:
            raise ValueError("该分类已经存在") from exc
        return {"id": category_id, "source_name": name, "display_name": name, "enabled": True}
    category_id = safe_text(payload, "category_id", 64)
    with account_connection() as connection:
        row = connection.execute(
            "SELECT id,source_name,display_name,is_custom FROM managed_categories WHERE id=?",
            (category_id,),
        ).fetchone()
        if not row:
            raise KeyError("分类不存在")
        if action == "category_update":
            display = normalize_label(payload.get("display_name"), maximum=40, field="分类显示名")
            description = optional_text(payload, "description", 240)
            enabled = strict_bool(payload, "enabled")
            sort_order = min(max(int(payload.get("sort_order") or 100), 0), 10_000)
            connection.execute(
                "UPDATE managed_categories SET display_name=?,description=?,enabled=?,sort_order=?,updated_at=? WHERE id=?",
                (display, description, int(enabled), sort_order, stamp, category_id),
            )
            return dict(row) | {"display_name": display, "enabled": enabled, "sort_order": sort_order}
        if action == "category_delete":
            if not bool(row["is_custom"]):
                raise ValueError("内置分类只能停用，不能删除")
            service = service_instance()
            existing = service.browse_catalog(
                library="all",
                category=str(row["source_name"]),
                page=1,
                page_size=1,
            )
            if int(existing.get("total") or 0):
                raise ValueError("分类下仍有正式书目，请先迁移书籍后再删除")
            connection.execute("DELETE FROM managed_categories WHERE id=?", (category_id,))
            return dict(row)
    raise ValueError("分类操作不在允许列表中")


def queue_admin_novel(payload: dict[str, Any]) -> dict[str, Any]:
    token = safe_text(payload, "upload_token", 32)
    if not re.fullmatch(r"[a-f0-9]{32}", token):
        raise ValueError("上传标识无效")
    request = {
        "upload_token": token,
        "title": normalize_label(payload.get("title"), maximum=120, field="书名"),
        "author": normalize_label(payload.get("author"), maximum=80, field="作者"),
        "category": normalize_label(payload.get("category"), maximum=40, field="分类"),
        "serialization_status": safe_text(payload, "serialization_status", 16),
        "summary": optional_text(payload, "summary", 2000),
        "source": normalize_label(payload.get("source"), maximum=160, field="来源说明"),
        "authorization": safe_text(payload, "authorization", 16),
        "manuscript_filename": Path(optional_text(payload, "manuscript_filename", 180) or "book.txt").name,
        "cover_content_type": optional_text(payload, "cover_content_type", 100),
    }
    if request["serialization_status"] not in {"ongoing", "finished"}:
        raise ValueError("连载状态无效")
    if request["authorization"] != "confirmed":
        raise ValueError("必须确认拥有上传和发布授权")
    if Path(request["manuscript_filename"]).suffix.casefold() != ".txt":
        raise ValueError("后台正式入库当前仅支持 TXT 正文")
    with account_connection() as connection:
        category = connection.execute(
            "SELECT source_name FROM managed_categories WHERE source_name=? AND enabled=1",
            (request["category"],),
        ).fetchone()
    if not category:
        raise ValueError("上传分类不存在或已停用")
    return queue_job("admin_novel", request)


def import_admin_novel(request: dict[str, Any]) -> dict[str, Any]:
    token = safe_text(request, "upload_token", 32)
    body_path = UPLOAD_ROOT / f"{token}.novel-body"
    cover_path = UPLOAD_ROOT / f"{token}.novel-cover"
    try:
        for path, minimum, maximum in (
            (body_path, 100, 40 * 1024 * 1024),
            (cover_path, 1024, 12 * 1024 * 1024),
        ):
            info = path.lstat()
            if path.is_symlink() or not path.is_file() or not minimum <= info.st_size <= maximum:
                raise ValueError("隔离上传文件无效")
        from oohstory_library.services.download_security import DownloadSecurityScanner

        service = service_instance()
        scanner = DownloadSecurityScanner(UPLOAD_ROOT)
        body_scan = scanner.scan_file(
            body_path, extension="txt", source="admin_novel_upload", max_bytes=40 * 1024 * 1024
        )
        cover_content_type = str(
            request.get("cover_content_type") or ""
        ).casefold()
        cover_extension = {
            "image/jpeg": "jpg",
            "image/png": "png",
            "image/webp": "webp",
        }.get(cover_content_type)
        if not cover_extension:
            raise ValueError("封面仅支持 JPEG、PNG 或 WebP")
        cover_scan = scanner.scan_file(
            cover_path,
            extension=cover_extension,
            source="admin_novel_cover_upload",
            max_bytes=12 * 1024 * 1024,
        )
        raw = body_path.read_bytes()
        text = None
        for encoding in ("utf-8-sig", "gb18030"):
            try:
                text = raw.decode(encoding)
                break
            except UnicodeDecodeError:
                continue
        if text is None or len(text.strip()) < 100:
            raise ValueError("正文编码无法识别或内容过短")
        title = normalize_label(request.get("title"), maximum=120, field="书名")
        author = normalize_label(request.get("author"), maximum=80, field="作者")
        if service._existing_catalog_identity(title, author):
            raise ValueError("正式书库中已存在相同书名和作者")
        category = normalize_label(request.get("category"), maximum=40, field="分类")
        safe_title = re.sub(r"[\\/:*?\"<>|\x00-\x1f]+", "-", title).strip(" .-")[:100]
        safe_author = re.sub(r"[\\/:*?\"<>|\x00-\x1f]+", "-", author).strip(" .-")[:60]
        destination_dir = (service.books_root / category).resolve()
        destination_dir.relative_to(service.books_root.resolve())
        destination_dir.mkdir(parents=True, exist_ok=True)
        destination = destination_dir / f"{safe_title}-{safe_author}.txt"
        if destination.exists():
            raise ValueError("书库目标正文已存在，已拒绝覆盖")
        temporary = destination.with_suffix(".txt.part")
        temporary.write_text(text, encoding="utf-8", newline="\n")
        temporary.chmod(0o640)
        os.replace(temporary, destination)
        digest = hashlib.sha256(destination.read_bytes()).hexdigest()
        source_id = f"admin-upload-{uuid.uuid4().hex}"
        catalog_id: int | None = None
        try:
            catalog_id = service._insert_imported_catalog_row(
                source_id=source_id,
                title=title,
                author=author,
                category=category,
                detail_url=f"admin://upload/{source_id}",
                file_url="",
                output_path=destination,
                sha256=digest,
                book_status=("连载中" if request.get("serialization_status") == "ongoing" else "已完结"),
            )
            cover = service.upload_catalog_cover(
                catalog_id,
                data=cover_path.read_bytes(),
                filename="cover",
                content_type=cover_content_type,
            )
            index = service.queue_ingestion_index_refresh(
                [catalog_id], reason="admin_novel_upload", wait=False
            )
        except Exception:
            if catalog_id:
                try:
                    service.delete_catalog_books(
                        catalog_ids=[catalog_id],
                        confirmation="确认删除1本书",
                    )
                except Exception:
                    pass
            else:
                destination.unlink(missing_ok=True)
            raise
        return {
            "catalog_id": int(catalog_id),
            "title": title,
            "category": category,
            "bytes": destination.stat().st_size,
            "sha256": digest,
            "cover": cover,
            "index": index,
            "scan": {"body": body_scan, "cover": cover_scan},
        }
    finally:
        body_path.unlink(missing_ok=True)
        cover_path.unlink(missing_ok=True)


def job_path(job_id: str) -> Path:
    if not JOB_ID_RE.fullmatch(job_id):
        raise ValueError("任务标识无效")
    return JOB_ROOT / f"{job_id}.json"


def atomic_job(path: Path, value: dict[str, Any]) -> None:
    value["updated_at"] = now()
    temporary = path.with_suffix(".json.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    try:
        data = memoryview(json.dumps(value, ensure_ascii=False, indent=2).encode("utf-8"))
        while data:
            written = os.write(descriptor, data)
            if written <= 0:
                raise OSError("short job state write")
            data = data[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    os.chmod(path, 0o640)


def queue_job(kind: str, payload: dict[str, Any]) -> dict[str, Any]:
    job_id = uuid.uuid4().hex[:20]
    path = job_path(job_id)
    job = {
        "job_id": job_id,
        "kind": kind,
        "status": "queued",
        "request": payload,
        "created_at": now(),
        "message": "任务已进入后台队列",
    }
    atomic_job(path, job)
    unit = f"oohstory-admin-library-action-{job_id}.service"
    completed = subprocess.run(
        [
            "/usr/bin/systemd-run",
            "--unit",
            unit,
            "--collect",
            "--property=Type=exec",
            "--property=User=root",
            "--property=WorkingDirectory=/opt/oohstory-admin",
            "--property=TimeoutStartSec=6h",
            "/opt/oohstory-admin/.venv/bin/python",
            str(RUNNER_PATH),
            "--run-job",
            job_id,
        ],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if completed.returncode:
        job.update(status="failed", message="后台任务单元启动失败")
        atomic_job(path, job)
        raise RuntimeError("后台任务单元启动失败")
    job.update(status="running", unit=unit, message="后台任务已启动")
    atomic_job(path, job)
    return {key: job[key] for key in ("job_id", "kind", "status", "message", "created_at", "updated_at")}


def sanitized_job(job: dict[str, Any]) -> dict[str, Any]:
    allowed = {
        "job_id", "kind", "status", "message", "created_at", "updated_at",
        "started_at", "finished_at", "result", "error", "unit",
    }
    return {key: value for key, value in job.items() if key in allowed}


