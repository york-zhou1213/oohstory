def delete_catalog_books(payload: dict[str, Any]) -> dict[str, Any]:
    """Delegate one bounded deletion to OOHStory's own catalog CLI."""

    unexpected = set(payload) - {"action", "catalog_ids", "confirmation"}
    if unexpected:
        raise ValueError("批量删除请求包含未允许字段")
    values = payload.get("catalog_ids")
    if not isinstance(values, list) or any(
        type(value) is not int or value <= 0 for value in values
    ):
        raise ValueError("catalog_ids 必须是显式正整数数组")
    selected = sorted(set(values))
    if not selected:
        raise ValueError("请至少选择一本作品")
    if len(selected) > 100:
        raise ValueError("单次最多处理 100 本作品")
    confirmation = safe_text(payload, "confirmation", 64)
    expected = f"确认删除{len(selected)}本书"
    if confirmation != expected:
        raise ValueError(f"请输入确认短语：{expected}")
    if not OOHSTORY_PYTHON.is_file():
        raise RuntimeError("统一删除运行环境不可用")
    if not OOHSTORY_CATALOG_DELETE.is_file():
        raise RuntimeError("统一删除入口尚未部署")
    load_environment()
    request = json.dumps(
        {"catalog_ids": selected, "confirmation": confirmation},
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    try:
        completed = subprocess.run(
            [str(OOHSTORY_PYTHON), str(OOHSTORY_CATALOG_DELETE)],
            input=request,
            capture_output=True,
            timeout=540,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError("统一删除任务不可用或执行超时") from exc
    if len(completed.stdout) > 4 * 1024 * 1024:
        raise RuntimeError("统一删除响应超过安全上限")
    try:
        result = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        raise RuntimeError(detail[-500:] or "统一删除入口返回无效响应") from exc
    if not isinstance(result, dict):
        raise RuntimeError("统一删除入口返回无效响应")
    if completed.returncode != 0 or result.get("ok") is not True:
        raise RuntimeError(str(result.get("error") or "统一删除失败")[:500])
    returned_ids = result.get("catalog_ids")
    if returned_ids != selected or int(result.get("deleted") or 0) != len(selected):
        raise RuntimeError("统一删除结果与明确选择不一致")
    return result


async def execute_job(job_id: str) -> None:
    ensure_roots()
    path = job_path(job_id)
    job = json.loads(path.read_text(encoding="utf-8"))
    job.update(status="running", started_at=now(), message="任务正在执行")
    atomic_job(path, job)
    try:
        service = service_instance()
        request = dict(job.get("request") or {})
        if job["kind"] == "cover":
            result = await service.batch_catalog_covers(
                ids(request, maximum=200), action=safe_text(request, "cover_action", 16)
            )
        elif job["kind"] == "import":
            provider = safe_text(request, "provider", 64)
            if provider not in IMPORT_PROVIDERS:
                raise ValueError("未知或未授权的远程书源")
            from oohstory_library.services.ai_service import get_ai_service

            result = await service.import_public_book(
                provider=provider,
                remote_id=safe_text(request, "remote_id", 160),
                source_ref=str(request.get("source_ref") or "")[:1000],
                book_status=str(request.get("book_status") or "")[:32],
                defer_postprocess=True,
                ai_service=get_ai_service(),
            )
            service.start_queued_ingestion_index_refresh(wait=False)
        elif job["kind"] == "admin_novel":
            result = import_admin_novel(request)
        else:
            raise ValueError("未知后台任务")
        job.update(status="completed", result=result, message="任务执行完成")
    except Exception as exc:
        job.update(status="failed", error=str(exc)[:1000], message="任务执行失败")
    job["finished_at"] = now()
    atomic_job(path, job)


async def dispatch(payload: dict[str, Any]) -> dict[str, Any]:
    action = str(payload.get("action") or "")
    if action == "capabilities":
        return {
            "actions": [
                "search", "move", "cover", "upload_cover", "import",
                "delete_catalog_books",
                "deconstruct", "resume", "deconstruction_batch",
                "task_runners", "task_detail", "sync_status", "sync_control",
                "site_full_sync", "cover_redraw_control",
                "index_refresh", "plot_query", "plot_plan", "plot_preview",
                "plot_apply", "plot_adaptations",
                "operations_overview", "invite_create", "invite_revoke",
                "registered_user_status", "registered_user_sessions_revoke",
                "category_create", "category_update", "category_delete",
                "admin_novel_upload", "book_publication_overview",
                "book_publication_status",
            ],
            "move_limit": 500,
            "cover_limit": 200,
            "delete_limit": 100,
            "project_tone_matching": False,
        }
    if action == "task_runners":
        from oohstory_library.services.library_task_runners import task_runner_catalog

        return task_runner_catalog(refresh=True)
    allowed_actions = {
        "job_status", "search", "move", "cover", "import",
        "delete_catalog_books",
        "deconstruct", "resume", "deconstruction_batch", "task_detail", "upload_cover",
        "sync_status", "sync_control", "site_full_sync", "cover_redraw_control", "index_refresh", "plot_query", "plot_plan",
        "plot_preview", "plot_apply", "plot_adaptations",
        "operations_overview", "invite_create", "invite_revoke",
        "registered_user_status", "registered_user_sessions_revoke",
        "category_create", "category_update", "category_delete",
        "admin_novel_upload", "book_publication_overview",
        "book_publication_status",
    }
    if action not in allowed_actions:
        raise ValueError("操作不在允许列表中")
    ensure_roots()
    if action == "operations_overview":
        return operations_overview(payload)
    if action == "book_publication_overview":
        return book_publication_overview(payload)
    if action == "book_publication_status":
        return update_book_publication(payload)
    if action == "invite_create":
        return create_registration_invite(payload)
    if action == "invite_revoke":
        return revoke_registration_invite(payload)
    if action == "registered_user_status":
        return update_registered_user(payload)
    if action == "registered_user_sessions_revoke":
        return revoke_registered_user_sessions(payload)
    if action in {"category_create", "category_update", "category_delete"}:
        return mutate_managed_category(action, payload)
    if action == "admin_novel_upload":
        return queue_admin_novel(payload)
    if action == "job_status":
        path = job_path(safe_text(payload, "job_id", 20))
        if not path.is_file() or path.is_symlink() or path.stat().st_size > 4 * 1024 * 1024:
            raise KeyError("后台任务不存在")
        return sanitized_job(json.loads(path.read_text(encoding="utf-8")))
    if action == "delete_catalog_books":
        return delete_catalog_books(payload)
    service = service_instance()
    if action == "sync_status":
        return service.sync_controls_status()
    if action == "sync_control":
        library_id = safe_text(payload, "library_id", 16)
        if library_id not in {"local", "fanqie"}:
            raise ValueError("未知书库同步开关")
        pipeline = optional_text(payload, "pipeline", 16) or "content"
        if pipeline != "content":
            raise ValueError("当前后台只允许正文同步开关")
        enabled = strict_bool(payload, "enabled")
        return service.set_sync_control(
            library_id,
            enabled,
            pipeline,
        )
    if action == "site_full_sync":
        site_id = safe_text(payload, "site_id", 16)
        library_id = SITE_FULL_SYNC_GROUPS.get(site_id)
        if not library_id:
            raise ValueError("未知正文同步站点")
        enabled = strict_bool(payload, "enabled")
        books_per_cycle = optional_positive_int(payload, "books_per_cycle")
        return service.set_site_full_sync(
            site_id,
            enabled,
            books_per_cycle=books_per_cycle,
        )
    if action == "cover_redraw_control":
        target_per_hour = optional_positive_int(payload, "target_per_hour")
        if target_per_hour is None:
            raise ValueError("target_per_hour 必须是正整数")
        raw_enabled = payload.get("enabled")
        enabled = (
            None if raw_enabled is None else strict_bool(payload, "enabled")
        )
        return service.set_cover_redraw_control(target_per_hour, enabled)
    if action == "index_refresh":
        index_kind = safe_text(payload, "index_kind", 16)
        force = strict_bool(payload, "force")
        if index_kind == "tone":
            return await service.start_index(force=force)
        if index_kind == "plot":
            return await service.start_plot_index(force=force)
        raise ValueError("未知索引类型")
    if action == "plot_query":
        question = safe_text(payload, "question", 500)
        if len(question) < 2:
            raise ValueError("提问至少需要 2 个字符")
        limit = max(1, min(int(payload.get("limit") or 8), 12))
        from oohstory_library.services.ai_service import get_ai_service

        return await service.answer_plot_question(
            PROJECT_ROOT, question, get_ai_service(), limit=limit
        )
    if action == "plot_plan":
        question = safe_text(payload, "question", 500)
        if len(question) < 2:
            raise ValueError("提问至少需要 2 个字符")
        selected = ids(payload, maximum=12)
        target_mode = optional_text(payload, "target_mode", 32) or "ai_recommended"
        if target_mode not in {"ai_recommended", "specified_chapter", "plot_arc"}:
            raise ValueError("未知的剧情融入模式")
        from oohstory_library.services.ai_service import get_ai_service

        return await service.plan_plot_adaptation(
            PROJECT_ROOT,
            question=question,
            catalog_ids=selected,
            requirement=optional_text(payload, "requirement", 2000),
            target_mode=target_mode,
            target_chapter=optional_positive_int(payload, "target_chapter"),
            start_chapter=optional_positive_int(payload, "start_chapter"),
            end_chapter=optional_positive_int(payload, "end_chapter"),
            ai_service=get_ai_service(),
        )
    if action == "plot_preview":
        plan_id = safe_text(payload, "plan_id", 12)
        if not PLAN_ID_RE.fullmatch(plan_id):
            raise ValueError("剧情融入方案标识无效")
        apply_mode = optional_text(payload, "apply_mode", 32) or "local_insert"
        if apply_mode not in {"local_insert", "replace_chapter"}:
            raise ValueError("未知的正文融入方式")
        from oohstory_library.services.ai_service import get_ai_service

        return await service.preview_plot_adaptation(
            PROJECT_ROOT, plan_id, apply_mode, get_ai_service()
        )
    if action == "plot_apply":
        plan_id = safe_text(payload, "plan_id", 12)
        if not PLAN_ID_RE.fullmatch(plan_id):
            raise ValueError("剧情融入方案标识无效")
        operation = safe_text(payload, "operation", 16)
        if operation == "bind":
            return service.apply_plot_adaptation(PROJECT_ROOT, plan_id)
        if operation == "commit":
            return service.commit_plot_adaptation(PROJECT_ROOT, plan_id)
        raise ValueError("未知的剧情融入操作")
    if action == "plot_adaptations":
        items = service.list_plot_adaptations(PROJECT_ROOT)[:100]
        return {
            "items": items,
            "project": service.project_profile(PROJECT_ROOT),
            "project_root": str(PROJECT_ROOT),
        }
    if action == "upload_cover":
        catalog_id = ids({"catalog_ids": [payload.get("catalog_id")]}, maximum=1)[0]
        token = safe_text(payload, "upload_token", 32)
        if not re.fullmatch(r"[a-f0-9]{32}", token):
            raise ValueError("上传标识无效")
        path = UPLOAD_ROOT / f"{token}.bin"
        try:
            info = path.lstat()
            if path.is_symlink() or not path.is_file() or info.st_size < 1024 or info.st_size > 12 * 1024 * 1024:
                raise ValueError("上传封面不是安全的普通文件")
            data = path.read_bytes()
        finally:
            path.unlink(missing_ok=True)
        return service.upload_catalog_cover(
            catalog_id,
            data=data,
            filename="cover",
            content_type=optional_text(payload, "content_type", 100),
        )
    if action == "task_detail":
        task_id = safe_text(payload, "task_id", 12)
        if not TASK_ID_RE.fullmatch(task_id):
            raise ValueError("拆书任务标识无效")
        task = service.get_task(PROJECT_ROOT, task_id)
        task["log"] = service.read_task_log(PROJECT_ROOT, task_id, max_chars=50000)
        return task
    if action == "search":
        source = safe_text(payload, "source", 64)
        if source not in SEARCH_SOURCES:
            raise ValueError("未知书源")
        query = safe_text(payload, "query", 100)
        if len(query) < 2:
            raise ValueError("作品名或作者名至少需要 2 个字符")
        limit = max(1, min(int(payload.get("limit") or 24), 100))
        return await service.global_book_search(query, source=source, limit=limit)
    if action == "move":
        target = safe_text(payload, "target_library", 16)
        return service.move_catalog_books(catalog_ids=ids(payload, maximum=500), target_library=target)
    if action == "cover":
        cover_action = safe_text(payload, "cover_action", 16)
        if cover_action not in {"sync", "redraw"}:
            raise ValueError("未知封面操作")
        selected = ids(payload, maximum=200)
        return queue_job("cover", {"catalog_ids": selected, "cover_action": cover_action})
    if action == "import":
        provider = safe_text(payload, "provider", 64)
        if provider not in IMPORT_PROVIDERS:
            raise ValueError("未知或未授权的远程书源")
        request = {
            "provider": provider,
            "remote_id": safe_text(payload, "remote_id", 160),
            "source_ref": str(payload.get("source_ref") or "")[:1000],
            "book_status": str(payload.get("book_status") or "")[:32],
        }
        return queue_job("import", request)
    if action == "deconstruct":
        catalog_id = ids({"catalog_ids": [payload.get("catalog_id")]}, maximum=1)[0]
        mode = safe_text(payload, "mode", 16)
        if mode not in {"scan", "full"}:
            raise ValueError("未知拆书模式")
        runner_id = optional_text(payload, "runner_id", 64)
        profile_id = optional_text(payload, "profile_id", 128)
        reasoning_effort = optional_text(payload, "reasoning_effort", 32)
        return service.create_task(
            PROJECT_ROOT,
            catalog_id,
            mode,
            runner_id=runner_id or None,
            profile_id=profile_id or None,
            reasoning_effort=reasoning_effort or None,
        )
    if action == "resume":
        task_id = safe_text(payload, "task_id", 12)
        if not TASK_ID_RE.fullmatch(task_id):
            raise ValueError("拆书任务标识无效")
        return service.continue_task(PROJECT_ROOT, task_id)
    if action == "deconstruction_batch":
        mode = safe_text(payload, "mode", 16)
        if mode not in {"scan", "full"}:
            raise ValueError("未知拆书模式")
        scope = optional_text(payload, "scope", 16) or "selected"
        if scope not in {"selected", "filtered"}:
            raise ValueError("批量范围无效")
        selected = ids(payload, maximum=500) if scope == "selected" else None
        state = optional_text(payload, "state", 16) or "unstarted"
        if state not in {"all", "unstarted", "running", "scan", "full", "error"}:
            raise ValueError("拆书状态筛选无效")
        query = optional_text(payload, "query", 100)
        category = optional_text(payload, "category", 100)
        runner_id = optional_text(payload, "runner_id", 64)
        profile_id = optional_text(payload, "profile_id", 128)
        reasoning_effort = optional_text(payload, "reasoning_effort", 32)
        if not runner_id or not profile_id:
            from oohstory_library.services.library_task_runners import task_runner_catalog

            runner_catalog = task_runner_catalog(refresh=True)
            runner_id = str(runner_catalog.get("default_runner") or "")
            runner = next(
                (item for item in runner_catalog.get("runners", []) if item.get("id") == runner_id),
                None,
            )
            if not runner or not runner.get("available"):
                raise ValueError("当前没有可用的拆书执行工具")
            profile_id = str(runner.get("default_profile") or "")
            if not profile_id:
                raise ValueError("默认拆书模型未配置")
        return service.create_deconstruction_batch(
            PROJECT_ROOT,
            mode=mode,
            runner_id=runner_id,
            profile_id=profile_id,
            reasoning_effort=reasoning_effort or None,
            state=state,
            query=query,
            category=category,
            catalog_ids=selected,
        )
    raise ValueError("操作不在允许列表中")


def main() -> None:
    if os.geteuid() != 0:
        emit(False, "书库操作助手必须由 root 执行", code=77)
    configure_root_runtime_environment()
    if len(sys.argv) == 3 and sys.argv[1] == "--run-job":
        try:
            asyncio.run(execute_job(sys.argv[2]))
        except Exception:
            raise SystemExit(1)
        raise SystemExit(0)
    if len(sys.argv) == 2 and sys.argv[1] == "--dispatch-stdin":
        pass
    elif len(sys.argv) != 1:
        emit(False, "不接受命令行参数", code=64)
    try:
        data = asyncio.run(dispatch(read_request()))
        emit(True, str(data.get("message") or "操作完成") if isinstance(data, dict) else "操作完成", data if isinstance(data, dict) else {})
    except (ValueError, KeyError) as exc:
        emit(False, str(exc).strip("'"), code=64)
    except Exception as exc:
        emit(False, str(exc)[:500] or "书库操作失败", code=1)


if __name__ == "__main__":
    main()
