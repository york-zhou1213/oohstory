# Install as /etc/sudoers.d/oohstory-admin with owner root:root and mode 0440.
# The root-owned helper performs a second exact action/unit allowlist check.
oohstory-admin ALL=(root) NOPASSWD: /usr/local/libexec/oohstory-admin-systemctl *
# Shared-library mutations accept JSON on stdin and no user-selected path.
oohstory-admin ALL=(root) NOPASSWD: /usr/local/libexec/oohstory-admin-library-action
# Public maintenance mode uses a fixed marker and a three-action helper.
oohstory-admin ALL=(root) NOPASSWD: /usr/local/libexec/oohstory-admin-maintenance status
oohstory-admin ALL=(root) NOPASSWD: /usr/local/libexec/oohstory-admin-maintenance enable
oohstory-admin ALL=(root) NOPASSWD: /usr/local/libexec/oohstory-admin-maintenance disable
