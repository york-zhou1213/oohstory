# Public URL and host validation
OOHSTORY_PUBLIC_ORIGIN=http://localhost:8091
OOHSTORY_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Library. SQLite is the safest local default.
OOHSTORY_CATALOG_BACKEND=sqlite
OOHSTORY_LIBRARY_ROOT=./data/library
OOHSTORY_OBJECT_ROOT=./data/library
OOHSTORY_STATE_ROOT=./var
OOHSTORY_DECONSTRUCTION_ROOT=

# Optional MySQL catalog. Store the password in a chmod 0600 file.
OOHSTORY_MYSQL_HOST=127.0.0.1
OOHSTORY_MYSQL_PORT=3306
OOHSTORY_MYSQL_DATABASE=oohstory_library
OOHSTORY_MYSQL_USER=oohstory_reader
OOHSTORY_MYSQL_PASSWORD_FILE=
OOHSTORY_MYSQL_POOL_SIZE=8

# Accounts and uploads
OOHSTORY_ACCOUNT_DATABASE=./var/accounts.sqlite3
OOHSTORY_USER_UPLOAD_ROOT=./var/user-uploads
OOHSTORY_USER_AVATAR_ROOT=./var/user-avatars
OOHSTORY_SUBMISSION_HANDOFF_ROOT=./var/submission-handoff
OOHSTORY_MAX_UPLOAD_BYTES=67108864
OOHSTORY_UPLOAD_DAILY_FILES=5
OOHSTORY_UPLOAD_DAILY_BYTES=268435456

# Optional Google Identity Services. Leave blank to disable.
OOHSTORY_GOOGLE_WEB_CLIENT_ID=
OOHSTORY_GOOGLE_ANDROID_CLIENT_ID=
OOHSTORY_GOOGLE_IOS_CLIENT_ID=
OOHSTORY_GOOGLE_REDIRECT_URI=http://localhost:8091/api/v1/auth/google/callback

# Optional SMTP verification. Never commit the password file.
OOHSTORY_SMTP_HOST=
OOHSTORY_SMTP_PORT=587
OOHSTORY_SMTP_USERNAME=
OOHSTORY_SMTP_PASSWORD_FILE=
OOHSTORY_SMTP_FROM=
OOHSTORY_SMTP_STARTTLS=1

# Optional external submission reviewer.
OOHSTORY_SUBMISSION_REVIEW_COMMAND=
OOHSTORY_SUBMISSION_REVIEW_TIMEOUT=300
OOHSTORY_SUBMISSION_REVIEW_MODEL=
OOHSTORY_OPENCLAW_BIN=
