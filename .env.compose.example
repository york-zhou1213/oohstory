# Copying this file alone is not enough: run scripts/prepare_compose_env.py to
# generate strong local secrets and the empty library layout.
COMPOSE_PROJECT_NAME=oohstory
OOHSTORY_ADMIN_USERNAME=admin
OOHSTORY_ADMIN_PASSWORD_HASH=CHANGE_ME_WITH_SCRYPT_HASH
OOHSTORY_ADMIN_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
OOHSTORY_MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_32_RANDOM_CHARACTERS
OOHSTORY_MYSQL_WRITER_PASSWORD=CHANGE_ME_WITH_32_RANDOM_CHARACTERS
OOHSTORY_MYSQL_ADMIN_READER_PASSWORD=CHANGE_ME_WITH_32_RANDOM_CHARACTERS
OOHSTORY_MYSQL_PUBLIC_READER_PASSWORD=CHANGE_ME_WITH_32_RANDOM_CHARACTERS
OOHSTORY_PUBLIC_ORIGIN=http://localhost:8091
OOHSTORY_READER_PUBLISH_PORT=8091
OOHSTORY_ADMIN_PUBLISH_PORT=8092
OOHSTORY_MYSQL_PUBLISH_PORT=13306
